//@version=6
//@strategy_alert_message {{strategy.order.alert_message}}

// ************************************** POA ************************************** //
// ********************************************************************************* //

strategy("스퀴즈 모멘텀 비트코인 ATR (부분 청산 + 조기 손절) 카피", overlay = true, initial_capital = 5000, process_orders_on_close = true, commission_value = 0.02, margin_long = 1, margin_short = 1, default_qty_type=strategy.percent_of_equity, default_qty_value=100)
start_time = input.time(timestamp("2025-12-05T00:00:00+09:00"), title="자동매매 시작")
end_time = input.time(timestamp("2026-12-30T11:09:00+09:00"), title="자동매매 종료")

in_backtest_period = (time >= start_time) and (time <= end_time)
// Inputs
length     = input(20, title = "BB Length")
mult       = input(2.0, title = "BB MultFactor")
lengthKC   = input(35, title = "KC Length")
multKC     = input(1.0, title = "KC MultFactor")
useTrueRange = input.bool(true, title = "Use TrueRange (KC)")

ema_length = input.int(200, minval = 1)
timeFrame  = input.string("240")

initialCapital       = strategy.initial_capital
reinvestPercentage   = input.int(100, "Reinvest Percentage", minval = 0, maxval = 100)

atrStopLength     = input.int(14, "ATR Stop Length", minval = 1)
atrStopMultiplier = input.float(2.5, "ATR Stop Multiplier", minval = 0.1, maxval = 20.0, step = 0.1)
riskRewardRatio   = input.float(6.1, "손익비 (ATR 기준)", minval = 1.0, maxval = 20.0, step = 0.5)
maxLeverageInput  = input.float(5.0, "최대 레버리지", minval = 1.0, maxval = 50.0, step = 0.1)
maxRiskPctInput   = input.float(5, "최대 리스크 %", minval = 0.1, maxval = 100.0, step = 0.1) / 100.0

// 3연속 익절 후 리스크 관리 설정
enableConsecWinsRiskReduction = input.bool(true, "3연속 익절 후 리스크 감소 사용", tooltip = "3연속 익절 후 리스크 감소 기능 전체 on/off")
skipFirstSignalAfter3Wins = input.bool(true, "3연속 익절 후 첫 신호 스킵", tooltip = "3연속 익절 후 바로 다음 진입 신호를 건너뛰기 (리스크 감소와 독립적으로 작동)")
consecWinsRiskReductionRatio = input.float(0.06, "3연속 익절 후 리스크 감소 비율", minval = 0.05, maxval = 1.0, step = 0.01, tooltip = "3연속 익절 이상일 때 MAX_RISK_PCT에 곱할 비율 (0.5 = 50%)")
reducedRiskEntryCount = input.int(3, "리스크 감소 적용 횟수", minval = 1, maxval = 10, tooltip = "첫 신호 스킵 후 몇 번의 진입에 리스크 감소를 적용할지")

// N연속 손절 후 리스크 관리 설정
enableConsecLossesRiskReduction = input.bool(true, "N연속 손절 후 리스크 감소 사용", tooltip = "N연속 손절 후 리스크 감소 기능 전체 on/off")
consecLossesThreshold = input.int(2, "연속 손절 기준", minval = 2, maxval = 5, tooltip = "몇 번 연속 손절 후 리스크 감소를 적용할지")
consecLossesRiskReductionRatio = input.float(0.5, "연속 손절 후 리스크 감소 비율", minval = 0.1, maxval = 1.0, step = 0.1, tooltip = "연속 손절 후 MAX_RISK_PCT에 곱할 비율 (0.5 = 50%)")
reducedRiskEntryCountLoss = input.int(2, "연속 손절 후 리스크 감소 적용 횟수", minval = 1, maxval = 10, tooltip = "연속 손절 후 몇 번의 진입에 리스크 감소를 적용할지")

// 브레이크이븐 설정: 진입 후 N봉 지나면 손절가를 진입가로 올림
ENABLE_BREAKEVEN  = input.bool(true, "브레이크이븐 사용")
breakevenBars     = input.int(312, "Breakeven after N bars", minval = 1)

// 부분 청산 설정
ENABLE_PARTIAL_CLOSE = input.bool(true, "부분 청산 사용", tooltip = "일정 수익률 달성 시 일부 포지션만 청산하여 수익 보호")
partialClose1Pct = input.float(1.9, "1차 부분 청산 수익률 (%)", minval = 0.1, maxval = 10.0, step = 0.1, tooltip = "이 수익률 달성 시 1차 부분 청산 실행")
partialClose1Ratio = input.float(25.0, "1차 부분 청산 비율 (%)", minval = 1.0, maxval = 99.0, step = 1.0, tooltip = "1차 부분 청산 시 전체 포지션의 몇 %를 청산할지")
partialClose2Pct = input.float(2.1, "2차 부분 청산 수익률 (%)", minval = 0.1, maxval = 10.0, step = 0.1, tooltip = "이 수익률 달성 시 2차 부분 청산 실행")
partialClose2Ratio = input.float(25.0, "2차 부분 청산 비율 (%)", minval = 1.0, maxval = 99.0, step = 1.0, tooltip = "2차 부분 청산 시 전체 포지션의 몇 %를 청산할지 (1차 청산 후 남은 포지션 기준)")

// 지정가 주문 관리 설정
ENABLE_LIMIT_ORDER = input.bool(true, "지정가 주문 사용", tooltip = "지정가 주문으로 진입 시도 (10분 후 ±0.1% 수정, 봉 마감까지 유지)")
limitOrderWaitMinutes = input.int(10, "주문 대기 시간 (분)", minval = 1, maxval = 60, tooltip = "초기 주문 후 이 시간이 지나면 ±0.1%로 수정")
limitOrderAdjustPct = input.float(0.1, "주문 수정 비율 (%)", minval = 0.01, maxval = 1.0, step = 0.01, tooltip = "10분 후 미체결 시 진입가의 ±이 비율로 수정")

// 조기 손절 설정: 스퀴즈 모멘텀 반대 부호 전환 감지
ENABLE_EARLY_STOP = input.bool(true, "조기 손절 사용", tooltip = "스퀴즈 모멘텀 반대 부호 전환 시 조기 손절 실행")
earlyStopTimeframe = input.string("30", "조기 손절 확인 시간프레임", tooltip = "스퀴즈 모멘텀 확인 시간프레임 (30분 권장)")
earlyStopHours1 = input.int(3, "조기 손절 시간대 1 (시간)", minval = 1, maxval = 10, tooltip = "진입 후 이 시간 이내 반대 부호 전환 시 조기 손절")
earlyStopHours2 = input.int(40, "조기 손절 시간대 2 시작 (시간)", minval = 20, maxval = 60, tooltip = "진입 후 이 시간부터 조기 손절 적용 시작")
earlyStopHours2End = input.int(55, "조기 손절 시간대 2 종료 (시간)", minval = 30, maxval = 100, tooltip = "진입 후 이 시간까지 조기 손절 적용")

savePercentage    = 100 - reinvestPercentage
minReinvestment   = initialCapital / 2

MAX_LEVERAGE = maxLeverageInput
MAX_RISK_PCT = maxRiskPctInput
SL_LOW_PCT   = 0.01
SL_HIGH_PCT  = 0.03
MAX_SL_PCT   = input.float(2.0, "최대 스탑로스 %", minval = 0.1, maxval = 50.0) / 100.0  // 허용 가능한 최대 손절 폭

// Variables
source = close
basis  = ta.sma(source, length)
dev    = mult * ta.stdev(source, length)
upperBB = basis + dev
lowerBB = basis - dev

maKC      = ta.sma(source, lengthKC)
rangeKC   = useTrueRange ? ta.tr : (high - low)
rangemaKC = ta.sma(rangeKC, lengthKC)
upperKC   = maKC + rangemaKC * multKC
lowerKC   = maKC - rangemaKC * multKC

sqzOnCond  = (lowerBB > lowerKC) and (upperBB < upperKC)
sqzOffCond = (lowerBB < lowerKC) and (upperBB > upperKC)
noSqzCond  = not sqzOnCond and not sqzOffCond

squeezeVal = ta.linreg(source - math.avg(math.avg(ta.highest(high, lengthKC), ta.lowest(low, lengthKC)), ta.sma(close, lengthKC)), lengthKC, 0)

ema = request.security(syminfo.tickerid, timeFrame, ta.ema(close, ema_length))

// 조기 손절용: 30분 봉의 스퀴즈 모멘텀 값
squeezeVal30m = request.security(syminfo.tickerid, earlyStopTimeframe, squeezeVal)

var float capital           = initialCapital
var float savedProfit       = 0
var float reinvestedCapital = initialCapital
var float lastEntryPrice = na
var float lastEntryCapitalFraction = na
var float lastEntryAppliedLeverage = na
var float lastEntryActualLev = na
var float lastEntryRiskPctEquity = na
var float lastEntryTpPctEquity = na
var int   lastEntryDir = 0
var float activeLongStop = na
var float activeLongTp = na
var float activeShortStop = na
var float activeShortTp = na
var bool  pendingManualExit = false
var float pendingManualExitPct = na
var string pendingManualReason = ""
var int   prevPosDir = 0

// 브레이크이븐용 진입 바 인덱스 / 플래그
var int  entryBarIndex = na
var bool breakevenSet  = false

// 조기 손절용: 진입 시점의 스퀴즈 모멘텀 값 및 시간 추적
var float entrySqueezeVal = na
var int entryTime = na

// 연속 익절 추적
var int consecWins = 0
var int reducedRiskEntryCounter = 0  // 3연속 익절 완성 후 경과한 진입 횟수 (0 = 첫 신호, 1~4 = 리스크 감소 구간)

// 연속 손절 추적
var int consecLosses = 0
var int reducedRiskEntryCounterLoss = 0  // N연속 손절 완성 후 경과한 진입 횟수 (0 = 첫 진입, 1~N = 리스크 감소 구간)

// 부분 청산 추적 변수
var bool partialClose1Done = false  // 1차 부분 청산 완료 여부
var bool partialClose2Done = false  // 2차 부분 청산 완료 여부
var float initialPositionSize = na   // 진입 시 초기 포지션 크기

// 지정가 주문 관리 (10분 후 ±0.1% 수정, 봉 마감까지 유지)
var int pendingOrderBarIndex = na      // 주문 제출한 바 인덱스
var int pendingOrderTime = na          // 주문 제출 시간 (밀리초)
var float pendingOrderPrice = na       // 원래 진입가
var int pendingOrderDir = 0            // 1=롱, -1=숏, 0=없음
var bool orderAdjusted = false          // 주문이 ±0.1%로 수정되었는지
var float pendingOrderSize = na        // 주문 수량
var float pendingOrderStop = na        // 예상 손절가
var float pendingOrderTp = na         // 예상 익절가

float profitToSave = 0.0
float profitToReinvest = 0.0

// Simulated Profit Calculation (replace with your actual strategy logic)
profitLoss = strategy.netprofit - strategy.netprofit[1]

// Logic for handling profit or loss
if profitLoss != 0
    if profitLoss > 0
        profitToSave      := profitLoss * (100 - savePercentage) / 100
        profitToReinvest  := profitLoss * reinvestPercentage / 100
        savedProfit       := savedProfit + profitToSave
    else
        profitToReinvest := profitLoss

    reinvestedCapital := reinvestedCapital + profitToReinvest

    if reinvestedCapital < minReinvestment
        float neededFromSaved = minReinvestment - reinvestedCapital
        if savedProfit >= neededFromSaved
            savedProfit       := savedProfit - neededFromSaved
            reinvestedCapital := reinvestedCapital + neededFromSaved
        else
            reinvestedCapital := reinvestedCapital + savedProfit
            savedProfit       := 0

calcPositionSizing(slPct, riskReductionCounter, riskReductionCounterLoss) =>
    float leverageUsed = 1.0
    float capitalFrac  = 1.0
    slSafe = math.max(slPct, 0.0001)
    // 3연속 익절 완성 후 첫 진입부터 1~4번만 리스크 감소 적용 (첫 신호는 스킵되므로 첫 진입이 1)
    shouldApplyRiskReductionWins = enableConsecWinsRiskReduction and riskReductionCounter >= 1 and riskReductionCounter <= reducedRiskEntryCount
    // N연속 손절 완성 후 첫 진입부터 1~N번만 리스크 감소 적용
    shouldApplyRiskReductionLosses = enableConsecLossesRiskReduction and riskReductionCounterLoss >= 1 and riskReductionCounterLoss <= reducedRiskEntryCountLoss
    // 익절과 손절 리스크 감소 중 더 작은 값 적용 (더 보수적으로)
    effectiveMaxRiskPct = MAX_RISK_PCT
    if shouldApplyRiskReductionWins
        effectiveMaxRiskPct := effectiveMaxRiskPct * consecWinsRiskReductionRatio
    if shouldApplyRiskReductionLosses
        effectiveMaxRiskPct := effectiveMaxRiskPct * consecLossesRiskReductionRatio
    if slSafe <= SL_LOW_PCT
        // SL_LOW_PCT 이하일 때도 effectiveMaxRiskPct를 반영
        exposureFactor = effectiveMaxRiskPct / slSafe
        leverageUsed := math.max(1.0, math.min(exposureFactor, MAX_LEVERAGE))
        capitalFrac  := math.min(1.0, exposureFactor / leverageUsed)
    else if slSafe < SL_HIGH_PCT
        exposureFactor = effectiveMaxRiskPct / slSafe
        leverageUsed := math.max(1.0, math.min(exposureFactor, MAX_LEVERAGE))
        capitalFrac  := math.min(1.0, exposureFactor / leverageUsed)
    else if slSafe == SL_HIGH_PCT
        leverageUsed := 1.0
        capitalFrac  := 1.0
    else
        leverageUsed := 1.0
        capitalFrac  := math.min(1.0, effectiveMaxRiskPct / (slSafe * leverageUsed))
    [capitalFrac, leverageUsed]

longCondition  = squeezeVal > 0 and squeezeVal > nz(squeezeVal[1]) and close > ema and noSqzCond 
shortCondition = squeezeVal < 0 and squeezeVal < nz(squeezeVal[1]) and close < ema and noSqzCond 

closeLongCondition  = squeezeVal < 0 and squeezeVal < nz(squeezeVal[1])
closeShortCondition = ta.change(squeezeVal > 0 and squeezeVal > nz(squeezeVal[1]))

atrValue     = ta.atr(atrStopLength)
atrDistance  = atrValue * atrStopMultiplier
slPctActual  = atrDistance / close
slAllowed    = slPctActual <= MAX_SL_PCT
slPctForSizing = slAllowed ? slPctActual : MAX_SL_PCT

// 이전 바의 consecWins를 확인해서 3연속 익절 완성 여부 판단
int prevConsecWins = nz(consecWins[1], 0)
int currentConsecWins = consecWins
// 3연속 익절 완성 판단:
// 1. 이전 바에서 3 이상이었거나
// 2. 현재 바에서 3이 되었거나
// 3. reducedRiskEntryCounter가 0이고 prevConsecWins >= 2이면 (3연속 익절 후 첫 신호)
//    - 거래 #99 청산 시: consecWins=3, reducedRiskEntryCounter=0 설정
//    - 거래 #100 진입 시: prevConsecWins가 2일 수 있지만, reducedRiskEntryCounter=0이면 3연속 익절 후 첫 신호
bool threeWinsCompleted = prevConsecWins >= 3 or currentConsecWins >= 3 or (reducedRiskEntryCounter == 0 and prevConsecWins >= 2)

// 3연속 익절 완성 후 첫 신호 스킵 여부 판단 (리스크 감소와 독립적으로 작동)
// reducedRiskEntryCounter == 0이고 prevConsecWins >= 2이면 3연속 익절 후 첫 신호로 간주
// (거래 #99 청산 시 reducedRiskEntryCounter=0 설정, 거래 #100 진입 시 prevConsecWins가 2일 수 있음)
bool shouldSkipFirstSignal = skipFirstSignalAfter3Wins and reducedRiskEntryCounter == 0 and prevConsecWins >= 2 and (longCondition or shortCondition)

// 진입 조건이 만족될 때 카운터를 미리 증가시켜서 calcPositionSizing에 반영
// 첫 진입부터 1부터 카운트 시작 (0이면 첫 진입, 1이면 두 번째 진입...)
int currentRiskCounter = 0
int currentRiskCounterLoss = 0
bool willEnter = strategy.position_size == 0 and not shouldSkipFirstSignal and (longCondition or shortCondition) and in_backtest_period
// 스킵 완료 후 첫 진입인 경우 (-1) 카운터를 0으로 리셋
int adjustedCounter = reducedRiskEntryCounter == -1 ? 0 : reducedRiskEntryCounter
if willEnter and enableConsecWinsRiskReduction and (threeWinsCompleted or adjustedCounter > 0)
    // 첫 진입부터 1부터 시작 (adjustedCounter는 이전 진입 횟수)
    currentRiskCounter := adjustedCounter + 1
    if currentRiskCounter > reducedRiskEntryCount
        currentRiskCounter := 0  // 4번 이후 리셋

// 연속 손절 후 리스크 감소 카운터 계산
int prevConsecLosses = nz(consecLosses[1], 0)
bool lossesCompleted = prevConsecLosses >= consecLossesThreshold
int adjustedCounterLoss = reducedRiskEntryCounterLoss
if willEnter and enableConsecLossesRiskReduction and (lossesCompleted or adjustedCounterLoss > 0)
    // 첫 진입부터 1부터 시작
    currentRiskCounterLoss := adjustedCounterLoss + 1
    if currentRiskCounterLoss > reducedRiskEntryCountLoss
        currentRiskCounterLoss := 0  // N번 이후 리셋

[capitalFraction, appliedLeverage] = calcPositionSizing(slPctForSizing, currentRiskCounter, currentRiskCounterLoss)
capitalFraction := slAllowed ? capitalFraction : 0.0
capitalToUse = math.max(reinvestedCapital, 0) * capitalFraction
float positionSize = capitalToUse * appliedLeverage / close

// 첫 신호 스킵 처리 (포지션이 없을 때만)
if shouldSkipFirstSignal and strategy.position_size == 0 and in_backtest_period
    // 이번 바의 첫 진입 신호는 스킵
    positionSize := 0  // 진입하지 않음
    // 스킵 완료 표시를 위해 -1로 설정 (다음 바에서 스킵 조건을 만족하지 않도록)
    reducedRiskEntryCounter := -1
    log.info("[SKIP SIGNAL] 3연속 익절 후 첫 신호 스킵 (consecWins=" + str.tostring(prevConsecWins) + ", 첫 진입부터 카운트 시작)")

var float longStopPrice   = na
var float longTakeProfit  = na
var float shortStopPrice  = na
var float shortTakeProfit = na

// 지정가 주문 관리: 10분 후 미체결 시 ±0.1% 수정, 봉 마감까지 유지
bool hasPendingOrder = not na(pendingOrderTime) and pendingOrderDir != 0
int currentTimeMs = time
int waitTimeMs = limitOrderWaitMinutes * 60 * 1000  // 분을 밀리초로 변환
bool shouldAdjustOrder = hasPendingOrder and not orderAdjusted and (currentTimeMs - pendingOrderTime) >= waitTimeMs
bool isBarClose = barstate.isconfirmed

// 10분 후 미체결 주문 수정
if ENABLE_LIMIT_ORDER and shouldAdjustOrder and strategy.position_size == 0
    float adjustedPrice = na
    if pendingOrderDir == 1  // 롱
        adjustedPrice := pendingOrderPrice * (1 + limitOrderAdjustPct / 100)
        strategy.cancel("longPosition")
        strategy.entry("longPosition", strategy.long, qty = pendingOrderSize, limit = adjustedPrice)
        log.info("[LONG ORDER ADJUSTED] 원래가: " + str.tostring(pendingOrderPrice, "#.##") + " → 수정가: " + str.tostring(adjustedPrice, "#.##") + " (+" + str.tostring(limitOrderAdjustPct) + "%)")
    else if pendingOrderDir == -1  // 숏
        adjustedPrice := pendingOrderPrice * (1 - limitOrderAdjustPct / 100)
        strategy.cancel("shortPosition")
        strategy.entry("shortPosition", strategy.short, qty = pendingOrderSize, limit = adjustedPrice)
        log.info("[SHORT ORDER ADJUSTED] 원래가: " + str.tostring(pendingOrderPrice, "#.##") + " → 수정가: " + str.tostring(adjustedPrice, "#.##") + " (-" + str.tostring(limitOrderAdjustPct) + "%)")
    
    if not na(adjustedPrice)
        pendingOrderPrice := adjustedPrice
        orderAdjusted := true

// 봉 마감 시 미체결 주문 취소 (주문이 제출된 봉의 마감 시점)
bool isOrderBarClose = not na(pendingOrderBarIndex) and barstate.isconfirmed and bar_index > pendingOrderBarIndex
if ENABLE_LIMIT_ORDER and isOrderBarClose and hasPendingOrder and strategy.position_size == 0 
    if pendingOrderDir == 1
        strategy.cancel("longPosition")
        log.info("[LONG ORDER CANCELLED] 봉 마감까지 미체결, 주문 취소 (제출봉: " + str.tostring(pendingOrderBarIndex) + ")")
    else if pendingOrderDir == -1
        strategy.cancel("shortPosition")
        log.info("[SHORT ORDER CANCELLED] 봉 마감까지 미체결, 주문 취소 (제출봉: " + str.tostring(pendingOrderBarIndex) + ")")
    
    // 주문 상태 리셋
    pendingOrderBarIndex := na
    pendingOrderTime := na
    pendingOrderPrice := na
    pendingOrderDir := 0
    orderAdjusted := false
    pendingOrderSize := na
    pendingOrderStop := na
    pendingOrderTp := na

if positionSize > 0 and in_backtest_period
    if strategy.position_size == 0 and longCondition and not shouldSkipFirstSignal and (not hasPendingOrder or not ENABLE_LIMIT_ORDER)
        // 카운터를 미리 계산한 값으로 업데이트 (스킵 완료 후 첫 진입인 경우 -1에서 0으로 리셋됨)
        reducedRiskEntryCounter := currentRiskCounter
        reducedRiskEntryCounterLoss := currentRiskCounterLoss
        
        longStopPrice  := close - atrDistance
        longTakeProfit := close + atrDistance * riskRewardRatio
        
        // 지정가 주문 또는 시장가 주문
        if ENABLE_LIMIT_ORDER
            strategy.entry("longPosition", strategy.long, qty = positionSize, limit = close)
            pendingOrderBarIndex := bar_index
            pendingOrderTime := currentTimeMs
            pendingOrderPrice := close
            pendingOrderDir := 1
            orderAdjusted := false
            pendingOrderSize := positionSize
            pendingOrderStop := longStopPrice
            pendingOrderTp := longTakeProfit
            log.info("[LONG LIMIT ORDER] 지정가: " + str.tostring(close, "#.##") + " 수량: " + str.tostring(positionSize, "#.####"))
        else
            strategy.entry("longPosition", strategy.long, qty = positionSize)
        
        activeLongStop := longStopPrice
        activeLongTp   := longTakeProfit
        riskPctEquity  = capitalFraction * appliedLeverage * slPctActual * 100
        tpPctEquityLong = capitalFraction * appliedLeverage * ((longTakeProfit - close) / close) * 100
        equityNow      = math.max(strategy.equity, 0.0001)
        actualLevExp   = capitalToUse > 0 ? (capitalToUse * appliedLeverage) / equityNow : 0.0
        strategy.exit("Long TP/SL", "longPosition", stop = longStopPrice, limit = longTakeProfit)
        effectiveRiskPct = MAX_RISK_PCT
        riskReductionNote = ""
        if enableConsecWinsRiskReduction and currentRiskCounter >= 1 and currentRiskCounter <= reducedRiskEntryCount
            effectiveRiskPct := effectiveRiskPct * consecWinsRiskReductionRatio
            riskReductionNote := riskReductionNote + " (익절리스크감소:" + str.tostring(currentRiskCounter) + "/" + str.tostring(reducedRiskEntryCount) + ")"
        if enableConsecLossesRiskReduction and currentRiskCounterLoss >= 1 and currentRiskCounterLoss <= reducedRiskEntryCountLoss
            effectiveRiskPct := effectiveRiskPct * consecLossesRiskReductionRatio
            riskReductionNote := riskReductionNote + " (손절리스크감소:" + str.tostring(currentRiskCounterLoss) + "/" + str.tostring(reducedRiskEntryCountLoss) + ")"
        log.info("[LONG ENTRY] lev=" + str.tostring(appliedLeverage, "#.##") + "x actualLev=" + str.tostring(actualLevExp, "#.##") + "x risk=" + str.tostring(riskPctEquity, "#.##") + "% tp=" + str.tostring(tpPctEquityLong, "#.##") + "% sl_move=" + str.tostring(slPctActual * 100, "#.##") + "% consecWins=" + str.tostring(consecWins) + " consecLosses=" + str.tostring(consecLosses) + riskReductionNote)
        lastEntryPrice           := close
        lastEntryCapitalFraction := capitalFraction
        lastEntryAppliedLeverage := appliedLeverage
        lastEntryActualLev       := actualLevExp
        lastEntryRiskPctEquity   := riskPctEquity
        lastEntryTpPctEquity     := tpPctEquityLong
        lastEntryDir             := 1
        pendingManualExit        := false
        entryBarIndex            := bar_index    // 브레이크이븐용
        breakevenSet             := false
        // 부분 청산 상태 리셋
        partialClose1Done        := false
        partialClose2Done        := false
        initialPositionSize      := positionSize
        // 조기 손절용: 진입 시점의 스퀴즈 모멘텀 값 및 시간 저장
        entrySqueezeVal          := squeezeVal30m
        entryTime                := currentTimeMs

    if strategy.position_size == 0 and shortCondition and not shouldSkipFirstSignal and (not hasPendingOrder or not ENABLE_LIMIT_ORDER)
        // 카운터를 미리 계산한 값으로 업데이트
        reducedRiskEntryCounter := currentRiskCounter
        reducedRiskEntryCounterLoss := currentRiskCounterLoss
        
        shortStopPrice  := close + atrDistance
        shortTakeProfit := close - atrDistance * riskRewardRatio
        
        // 지정가 주문 또는 시장가 주문
        if ENABLE_LIMIT_ORDER
            strategy.entry("shortPosition", strategy.short, qty = positionSize, limit = close)
            pendingOrderBarIndex := bar_index
            pendingOrderTime := currentTimeMs
            pendingOrderPrice := close
            pendingOrderDir := -1
            orderAdjusted := false
            pendingOrderSize := positionSize
            pendingOrderStop := shortStopPrice
            pendingOrderTp := shortTakeProfit
            log.info("[SHORT LIMIT ORDER] 지정가: " + str.tostring(close, "#.##") + " 수량: " + str.tostring(positionSize, "#.####"))
        else
            strategy.entry("shortPosition", strategy.short, qty = positionSize)
        
        activeShortStop := shortStopPrice
        activeShortTp   := shortTakeProfit
        riskPctEquity   = capitalFraction * appliedLeverage * slPctActual * 100
        tpPctEquityShort = capitalFraction * appliedLeverage * ((close - shortTakeProfit) / close) * 100
        equityNow       = math.max(strategy.equity, 0.0001)
        actualLevExp    = capitalToUse > 0 ? (capitalToUse * appliedLeverage) / equityNow : 0.0
        strategy.exit("Short TP/SL", "shortPosition", stop = shortStopPrice, limit = shortTakeProfit)
        effectiveRiskPct = MAX_RISK_PCT
        riskReductionNote = ""
        if enableConsecWinsRiskReduction and currentRiskCounter >= 1 and currentRiskCounter <= reducedRiskEntryCount
            effectiveRiskPct := effectiveRiskPct * consecWinsRiskReductionRatio
            riskReductionNote := riskReductionNote + " (익절리스크감소:" + str.tostring(currentRiskCounter) + "/" + str.tostring(reducedRiskEntryCount) + ")"
        if enableConsecLossesRiskReduction and currentRiskCounterLoss >= 1 and currentRiskCounterLoss <= reducedRiskEntryCountLoss
            effectiveRiskPct := effectiveRiskPct * consecLossesRiskReductionRatio
            riskReductionNote := riskReductionNote + " (손절리스크감소:" + str.tostring(currentRiskCounterLoss) + "/" + str.tostring(reducedRiskEntryCountLoss) + ")"
        log.info("[SHORT ENTRY] lev=" + str.tostring(appliedLeverage, "#.##") + "x actualLev=" + str.tostring(actualLevExp, "#.##") + "x risk=" + str.tostring(riskPctEquity, "#.##") + "% tp=" + str.tostring(tpPctEquityShort, "#.##") + "% sl_move=" + str.tostring(slPctActual * 100, "#.##") + "% consecWins=" + str.tostring(consecWins) + " consecLosses=" + str.tostring(consecLosses) + riskReductionNote)
        lastEntryPrice           := close
        lastEntryCapitalFraction := capitalFraction
        lastEntryAppliedLeverage := appliedLeverage
        lastEntryActualLev       := actualLevExp
        lastEntryRiskPctEquity   := riskPctEquity
        lastEntryTpPctEquity     := tpPctEquityShort
        lastEntryDir             := -1
        pendingManualExit        := false
        entryBarIndex            := bar_index    // 브레이크이븐용
        breakevenSet             := false
        // 부분 청산 상태 리셋
        partialClose1Done        := false
        partialClose2Done        := false
        initialPositionSize      := positionSize
        // 조기 손절용: 진입 시점의 스퀴즈 모멘텀 값 및 시간 저장
        entrySqueezeVal          := squeezeVal30m
        entryTime                := currentTimeMs

// 포지션 체결 시 주문 상태 리셋
if strategy.position_size != 0 and hasPendingOrder
    pendingOrderBarIndex := na
    pendingOrderTime := na
    pendingOrderPrice := na
    pendingOrderDir := 0
    orderAdjusted := false
    pendingOrderSize := na
    pendingOrderStop := na
    pendingOrderTp := na

// === 조기 손절 로직: 스퀴즈 모멘텀 반대 부호 전환 감지 ===
// TP1 이상의 익절이 발생하기 전에만 동작 (partialClose1Done == false일 때만)
if ENABLE_EARLY_STOP and strategy.position_size != 0 and not na(entrySqueezeVal) and not na(entryTime) and not partialClose1Done
    // 진입 후 경과 시간 계산 (시간 단위)
    int hoursSinceEntry = (currentTimeMs - entryTime) / (1000 * 60 * 60)
    
    // 현재 스퀴즈 모멘텀 값
    float currentSqueezeVal = squeezeVal30m
    
    // 반대 부호 전환 확인
    bool reversalDetected = false
    bool inTimeWindow = false
    
    if lastEntryDir == 1  // 롱 포지션
        // 진입 시 양수였는데 현재 음수로 전환
        if entrySqueezeVal > 0 and currentSqueezeVal < 0
            reversalDetected := true
            // 시간대 확인: 3시간 이내, 8-9시간, 30-50시간 사이
            
            if hoursSinceEntry <= earlyStopHours1
                inTimeWindow := true
            else if hoursSinceEntry >= 8 and hoursSinceEntry <= 9
                inTimeWindow := true
            else if hoursSinceEntry >= earlyStopHours2 and hoursSinceEntry <= earlyStopHours2End
                inTimeWindow := true
    else if lastEntryDir == -1  // 숏 포지션
        // 진입 시 음수였는데 현재 양수로 전환
        if entrySqueezeVal < 0 and currentSqueezeVal > 0
            reversalDetected := true
            // 시간대 확인: 3시간 이내, 8-9시간, 30-50시간 사이
            
            if hoursSinceEntry <= earlyStopHours1
                inTimeWindow := true
            else if hoursSinceEntry >= 8 and hoursSinceEntry <= 9
                inTimeWindow := true
            
            else if hoursSinceEntry >= earlyStopHours2 and hoursSinceEntry <= earlyStopHours2End
                inTimeWindow := true
    
    // 조기 손절 실행 (TP1 발생 전에만)
    if reversalDetected and inTimeWindow
        if lastEntryDir == 1
            strategy.close("longPosition", comment = "Early Stop (Squeeze Reversal)")
            log.info("[EARLY STOP LONG] 반대 부호 전환 감지 - 진입 후 " + str.tostring(hoursSinceEntry) + "시간, 진입값: " + str.tostring(entrySqueezeVal, "#.##") + " → 현재값: " + str.tostring(currentSqueezeVal, "#.##"))
        else if lastEntryDir == -1
            strategy.close("shortPosition", comment = "Early Stop (Squeeze Reversal)")
            log.info("[EARLY STOP SHORT] 반대 부호 전환 감지 - 진입 후 " + str.tostring(hoursSinceEntry) + "시간, 진입값: " + str.tostring(entrySqueezeVal, "#.##") + " → 현재값: " + str.tostring(currentSqueezeVal, "#.##"))
        
        // 조기 손절 후 상태 리셋
        pendingManualExit := true
        pendingManualReason := "Early Stop (Squeeze Reversal)"
        pendingManualExitPct := -nz(lastEntryRiskPctEquity, 0)

// === 부분 청산 로직: 일정 수익률 달성 시 일부 포지션만 청산 ===
if ENABLE_PARTIAL_CLOSE and strategy.position_size != 0 and not na(lastEntryPrice) and not na(initialPositionSize)
    float currentProfitPct = 0.0
    float currentPositionSize = math.abs(strategy.position_size)
    
    // 현재 수익률 계산
    if lastEntryDir == 1  // 롱
        currentProfitPct := ((close - lastEntryPrice) / lastEntryPrice) * 100
    else if lastEntryDir == -1  // 숏
        currentProfitPct := ((lastEntryPrice - close) / lastEntryPrice) * 100
    
    // 1차 부분 청산: partialClose1Pct 수익률 달성 시
    if not partialClose1Done and currentProfitPct >= partialClose1Pct
        float closeQty = initialPositionSize * (partialClose1Ratio / 100)
        if closeQty > 0 and currentPositionSize >= closeQty
            if lastEntryDir == 1
                strategy.close("longPosition", qty = closeQty, comment = "Partial Close 1")
            else if lastEntryDir == -1
                strategy.close("shortPosition", qty = closeQty, comment = "Partial Close 1")
            
            partialClose1Done := true
            log.info("[" + (lastEntryDir == 1 ? "LONG" : "SHORT") + " PARTIAL CLOSE 1] 수익률: " + str.tostring(currentProfitPct, "#.##") + "%, 청산 수량: " + str.tostring(closeQty, "#.####") + " (" + str.tostring(partialClose1Ratio) + "%)")
    
    // 2차 부분 청산: partialClose2Pct 수익률 달성 시 (1차 청산 후 남은 포지션 기준)
    if partialClose1Done and not partialClose2Done and currentProfitPct >= partialClose2Pct
        float remainingPositionSize = initialPositionSize * (1 - partialClose1Ratio / 100)
        float closeQty = remainingPositionSize * (partialClose2Ratio / 100)
        if closeQty > 0 and currentPositionSize >= closeQty
            if lastEntryDir == 1
                strategy.close("longPosition", qty = closeQty, comment = "Partial Close 2")
            else if lastEntryDir == -1
                strategy.close("shortPosition", qty = closeQty, comment = "Partial Close 2")
            
            partialClose2Done := true
            log.info("[" + (lastEntryDir == 1 ? "LONG" : "SHORT") + " PARTIAL CLOSE 2] 수익률: " + str.tostring(currentProfitPct, "#.##") + "%, 청산 수량: " + str.tostring(closeQty, "#.####") + " (" + str.tostring(partialClose2Ratio) + "%, 남은 포지션 기준)")

// === Breakeven stop 로직: 진입 후 N봉 지나면 손절가를 진입가로 올림 ===
if ENABLE_BREAKEVEN and strategy.position_size != 0 and not na(lastEntryPrice) and not breakevenSet and not na(entryBarIndex)
    barsSinceEntry = bar_index - entryBarIndex
    if barsSinceEntry >= breakevenBars
        if lastEntryDir == 1 and not na(activeLongTp)
            newStop = lastEntryPrice
            activeLongStop := newStop
            // 기존 "Long TP/SL" 주문을 진입가 손절로 업데이트
            strategy.exit("Long TP/SL", "longPosition", stop = newStop, limit = activeLongTp)
            log.info("[LONG BREAKEVEN] stop moved to entry: " + str.tostring(newStop, "#.##"))
        else if lastEntryDir == -1 and not na(activeShortTp)
            newStop = lastEntryPrice
            activeShortStop := newStop
            // 기존 "Short TP/SL" 주문을 진입가 손절로 업데이트
            strategy.exit("Short TP/SL", "shortPosition", stop = newStop, limit = activeShortTp)
            log.info("[SHORT BREAKEVEN] stop moved to entry: " + str.tostring(newStop, "#.##"))
        breakevenSet := true

// Reset stop/target references when flat
if strategy.position_size <= 0
    longStopPrice  := na
    longTakeProfit := na

if strategy.position_size >= 0
    shortStopPrice  := na
    shortTakeProfit := na

currPosDir = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
if prevPosDir != 0 and currPosDir == 0 and lastEntryDir != 0
    string exitReason = "Exit"
    float pnlPctEquity = 0.0
    if pendingManualExit
        exitReason := pendingManualReason
        pnlPctEquity := nz(pendingManualExitPct, 0)
    else
        // 실제 체결된 거래의 손익을 기반으로 판단
        int closedTradesCount = strategy.closedtrades
        float actualProfit = 0.0
        if closedTradesCount > 0
            actualProfit := strategy.closedtrades.profit(closedTradesCount - 1)
        
        // 실제 손익이 양수면 TP, 음수면 SL로 판단
        if actualProfit > 0
            exitReason := "TakeProfit"
            pnlPctEquity := nz(lastEntryTpPctEquity, 0)
        else if actualProfit < 0
            exitReason := "StopLoss"
            pnlPctEquity := -nz(lastEntryRiskPctEquity, 0)
        else
            // 손익이 0이거나 확인 불가능한 경우, 가격 기반으로 재시도
            if prevPosDir == 1
                bool tpHit = not na(activeLongTp) and close >= activeLongTp
                bool slHit = not na(activeLongStop) and close <= activeLongStop
                exitReason := tpHit ? "TakeProfit" : slHit ? "StopLoss" : "Exit"
                pnlPctEquity := exitReason == "TakeProfit" ? nz(lastEntryTpPctEquity, 0) : -nz(lastEntryRiskPctEquity, 0)
            else
                bool tpHit = not na(activeShortTp) and close <= activeShortTp
                bool slHit = not na(activeShortStop) and close >= activeShortStop
                exitReason := tpHit ? "TakeProfit" : slHit ? "StopLoss" : "Exit"
                pnlPctEquity := exitReason == "TakeProfit" ? nz(lastEntryTpPctEquity, 0) : -nz(lastEntryRiskPctEquity, 0)
    
    // 연속 익절/손절 수 업데이트
    if exitReason == "TakeProfit"
        consecWins := consecWins + 1
        consecLosses := 0  // 익절 시 연속 손절 리셋
        // 3연속 익절 달성 시 다음 진입부터 첫 신호 스킵 및 리스크 감소 시작
        if consecWins == 3
            if enableConsecWinsRiskReduction
                reducedRiskEntryCounter := 0  // 다음 진입이 첫 신호가 되도록 0으로 설정
            log.info("[3 CONSECUTIVE WINS] 다음 신호 스킵 예정 (consecWins=3)")
    else if exitReason == "StopLoss" or exitReason == "Early Stop (Squeeze Reversal)"
        // 부분 청산 없이 바로 손절된 경우만 연속 손절 카운트
        // (부분 청산이 있는 거래의 TP/SL은 익절이므로 제외)
        bool isDirectStoploss = true  // TP/SL로 청산된 손절은 모두 직접 손절로 간주
        if isDirectStoploss
            consecLosses := consecLosses + 1
            consecWins := 0  // 손절 시 연속 익절 리셋
            // N연속 손절 달성 시 다음 진입부터 리스크 감소 시작
            if consecLosses >= consecLossesThreshold
                if enableConsecLossesRiskReduction
                    reducedRiskEntryCounterLoss := 0  // 다음 진입이 첫 진입이 되도록 0으로 설정
                log.info("[" + str.tostring(consecLosses) + " CONSECUTIVE LOSSES] 리스크 감소 시작 (consecLosses=" + str.tostring(consecLosses) + ")")
        else
            consecWins := 0
            consecLosses := 0
    else
        // 기타 청산 (Early Exit 등)
        consecWins := 0
        consecLosses := 0
    
    log.info("[" + (prevPosDir == 1 ? "LONG" : "SHORT") + " EXIT] reason=" + exitReason + " pnl=" + str.tostring(pnlPctEquity, "#.##") + "% actualLev=" + str.tostring(nz(lastEntryActualLev, 0), "#.##") + "x consecWins=" + str.tostring(consecWins))
    pendingManualExit := false
    pendingManualExitPct := na
    pendingManualReason := ""
    lastEntryDir := 0
    activeLongStop := na
    activeLongTp := na
    activeShortStop := na
    activeShortTp := na
    entryBarIndex := na          // 브레이크이븐 관련 리셋
    breakevenSet  := false
    // 부분 청산 상태 리셋
    partialClose1Done := false
    partialClose2Done := false
    initialPositionSize := na
    // 조기 손절 상태 리셋
    entrySqueezeVal := na
    entryTime := na
    // 지정가 주문 상태 리셋
    pendingOrderBarIndex := na
    pendingOrderTime := na
    pendingOrderPrice := na
    pendingOrderDir := 0
    orderAdjusted := false
    pendingOrderSize := na
    pendingOrderStop := na
    pendingOrderTp := na

prevPosDir := currPosDir

